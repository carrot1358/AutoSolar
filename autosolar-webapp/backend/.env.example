# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── MQTT Broker ───────────────────────────────────────────────────────────────
MQTT_BROKER_URL=mqtts://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=autosolar/sensor-data
MQTT_COMMANDS_TOPIC=autosolar/commands

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=./solar_data.db
